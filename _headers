# Cloudflare Pages: cabeçalhos por caminho (este arquivo não é publicado como página).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw=' 'sha256-ASaW1sYnXVc+/gYqNUdhrwhH9hD35avpQDfWJOeEPQo=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Sobre a Content-Security-Policy acima (o que o navegador pode carregar):
# - os dois sha256 liberam os únicos <script> escritos dentro do HTML: o de
#   index.html (classe "js" no <html>) e o do ano em privacy.html. Se mudar uma
#   letra de um deles, o hash muda e o script para de rodar: recalcular com
#     printf '%s' "CONTEUDO_DO_SCRIPT" | openssl dgst -sha256 -binary | base64
# - cloudflareinsights.com = Cloudflare Web Analytics (pode ser ligado no painel).
# - quando o formulário passar a enviar para um serviço externo (Formspree,
#   Web3Forms...), acrescentar o endereço dele em connect-src e form-action.

# fontes não mudam: cache longo
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# imagens, CSS e JS: cache de 1 dia (os nomes não têm versão; se trocar um
# arquivo mantendo o nome, em até 1 dia todos os visitantes recebem o novo)
/img/*
  Cache-Control: public, max-age=86400
/css/*
  Cache-Control: public, max-age=86400
/js/*
  Cache-Control: public, max-age=86400

# ícones e manifesto: mudam pouco
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

# SEO: robôs leem com frequência, mas aceitam cache curto
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

# página de erro nunca entra na busca (reforça o <meta name="robots"> dela)
/404
  X-Robots-Tag: noindex
/404.html
  X-Robots-Tag: noindex
